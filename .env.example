ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GITHUB_TOKEN_READ=
GITHUB_TOKEN_WRITE=
# Local Jira REST read-back and the owner-label check. Agents use vaults, not this file.
ATLASSIAN_READ_TOKEN=
