{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "codex-findings",
  "type": "object",
  "additionalProperties": true,
  "required": ["findings"],
  "properties": {
    "findings": {"type": "array"},
    "votes": {"type": "array"},
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {"type": ["integer", "null"]},
        "output_tokens": {"type": ["integer", "null"]},
        "amount_cents": {"type": ["integer", "null"]}
      }
    }
  }
}
