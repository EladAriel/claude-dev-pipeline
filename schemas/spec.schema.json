{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acceptance_criteria",
    "open_questions",
    "needs_human",
    "seams",
    "e2e_scenarios"
  ],
  "properties": {
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1}
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "blocks"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "blocks": {"type": "boolean"}
        }
      }
    },
    "needs_human": {"type": "boolean"},
    "seams": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "e2e_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "scenario"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "scenario": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
